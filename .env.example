# Copiar a .env y completar. NUNCA commitear el .env real.
# Generar clave: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-valor-seguro-de-50+-caracteres
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=sqlite:///db.sqlite3  # default local (se usa si no se define)

# Para producción (Railway: Service → Variables):
# DEBUG=0
# SECRET_KEY=<clave-larga-generada>
# ALLOWED_HOSTS=tu-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}  # la inyecta Railway al enlazar Postgres
# SECURE_HSTS_SECONDS=3600
# LOG_LEVEL=INFO
